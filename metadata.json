  "storage": [
    {"name":"hrsessions.app.js","url":"app.js"},
    {"name":"hrsessions.img","url":"app-icon.js","evaluate":true}
  ],
  "data": [
    {"wildcard":"hrsessions.log*.csv","storageFile":true},
    {"wildcard":"hrsessions.amb*.csv","storageFile":true}
  ]
}
