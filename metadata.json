{
  "id": "hrsessions",
  "name": "HR Sessions",
  "shortName": "HR Sessions",
  "version": "0.02",
  "description": "Track heart-rate sessions by activity (Jogging, Biking, Sleeping, Eating) and save them to durable, appendable CSV Session Files on the watch.",
  "tags": "tool,health",
  "supports": ["BANGLEJS2"],
  "icon": "app.png",
